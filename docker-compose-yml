services:
  chocohub:
    build:
      context: .
      dockerfile: Dockerfile

    container_name: chocohub-node

    restart: unless-stopped

    env_file:
      - ./config.env

    ports:
      - "3800:3800"

    volumes:
      - ./db:/app/db
      - ./node-data:/app/node-data
      - ./plots:/app/plots

    healthcheck:
      test:
        [
          "CMD-SHELL",
          "node -e \"require('http').get('http://127.0.0.1:3800/',r=>process.exit(r.statusCode < 500 ? 0 : 1)).on('error',()=>process.exit(1))\""
        ]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 20s

    stop_grace_period: 30s
